# Copy this file to `.env.local` and fill in real values.
# `.env.local` must never be committed (see .gitignore).

# --- Supabase (Phase 1) -----------------------------------------------
# Project Settings -> API in the Supabase dashboard.
# These are public/anon values by design and are safe to expose to the
# browser via the NEXT_PUBLIC_ prefix. Do NOT put a service-role key here
# or anywhere prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Map Providers (Phase 6) -------------------------------------------
# Geocoding Provider selection: "kakao" (default) or "naver". Switching this
# only swaps the Map Provider Adapter (src/lib/map/) -- it never requires
# changing the locations schema or Server Actions (SPEC 17~18장).
MAP_PROVIDER=kakao

# Keep the keys/secrets below server-only (no NEXT_PUBLIC_ prefix) -- they
# are never sent to the browser and are never stored in the database
# (src/lib/map/providers/*.ts reads them directly from process.env).

# Kakao Developers ("REST API key" of the app, NOT the JavaScript key) --
# https://developers.kakao.com/console/app -> 앱 설정 -> 앱 키
KAKAO_MAP_API_KEY=

# Naver Cloud Platform Maps application credentials --
# https://console.ncloud.com -> AI·NAVER API -> Maps -> Application
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
